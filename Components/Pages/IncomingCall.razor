@page "/calls"
@inject IJSRuntime JSRuntime
@inject ICallHandler CallHandler
@using Microsoft.Maui.Controls
@using PayRemind.Contracts
@using System.Timers

<MudLayout Style="height: 100vh; background-color: #2c3e50;">
    <MudContainer MaxWidth="MaxWidth.Small" Style="height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: 32px;" Class="d-flex align-center">
        
        <!-- Caller Info -->
        <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="mt-10">
             <MudAvatar Style="width: 120px; height: 120px; border: 4px solid white;">
                <MudImage Src="https://img.freepik.com/free-photo/ultra-detailed-nebula-abstract-wallpaper-4_1562-749.jpg" Alt="Caller" ObjectFit="ObjectFit.Cover" Width="120" Height="120" Class="rounded-circle" />
            </MudAvatar>
            <MudText Typo="Typo.h4" Align="Align.Center" Style="color: white;">@_incomingNumber</MudText>
            <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Inherit" Style="color: rgba(255,255,255,0.7);">@_callStatus</MudText>
            
            @if (_callStatus == "Active")
            {
                <MudText Typo="Typo.h5" Align="Align.Center" Style="color: white;">@_duration.ToString(@"mm\:ss")</MudText>
            }
        </MudStack>

        <!-- Actions -->
        @if (_callStatus == "Incoming" || _callStatus == "Ringing")
        {
            <MudStack Row="true" Justify="Justify.SpaceAround" Style="width: 100%; padding-bottom: 40px;">
                <MudFab Color="Color.Success" StartIcon="@Icons.Material.Filled.Call" Size="Size.Large" OnClick="AnswerCall" Label="Contestar" />
                <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.CallEnd" Size="Size.Large" OnClick="RejectCall" Label="Rechazar" />
            </MudStack>
        }
        else if (_callStatus == "Active" || _callStatus == "Dialing")
        {
             <MudGrid Class="mb-5" Justify="Justify.Center" Spacing="4">
                <MudItem xs="4" Class="d-flex justify-center">
                    <MudIconButton Icon="@(_isMuted ? Icons.Material.Filled.MicOff : Icons.Material.Filled.Mic)" 
                                   Color="@(_isMuted ? Color.Error : Color.Surface)" 
                                   Variant="Variant.Filled" Size="Size.Large" OnClick="ToggleMute" Class="rounded-circle pa-4" />
                </MudItem>
                <MudItem xs="4" Class="d-flex justify-center">
                    <MudIconButton Icon="@Icons.Material.Filled.Dialpad" Color="Color.Surface" Variant="Variant.Filled" Size="Size.Large" Class="rounded-circle pa-4" />
                </MudItem>
                <MudItem xs="4" Class="d-flex justify-center">
                    <MudIconButton Icon="@(_isSpeaker ? Icons.Material.Filled.VolumeUp : Icons.Material.Filled.VolumeOff)" 
                                   Color="@(_isSpeaker ? Color.Primary : Color.Surface)" 
                                   Variant="Variant.Filled" Size="Size.Large" OnClick="ToggleSpeaker" Class="rounded-circle pa-4" />
                </MudItem>
                
                 <MudItem xs="12" Class="d-flex justify-center mt-4">
                     <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.CallEnd" Size="Size.Large" OnClick="EndCall" Label="Colgar" Style="width: 80px; height: 80px;" />
                 </MudItem>
            </MudGrid>
        }
        else // Ended, etc
        {
             <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-10">
                 <MudText Typo="Typo.h5" Style="color: white;">Llamada Finalizada</MudText>
                  <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Style="color: white;" Size="Size.Large" OnClick="GoBack" />
             </MudStack>
        }

    </MudContainer>
</MudLayout>

@code {
    private string _incomingNumber = "Desconocido";
    private string _callStatus = "Incoming"; // Incoming, Active, Dialing, Ended
    private bool _isMuted = false;
    private bool _isSpeaker = false;
    private TimeSpan _duration;
    private System.Timers.Timer _timer;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(InfoStatic.PhoneNumber))
        {
            _incomingNumber = InfoStatic.PhoneNumber;
        }

        // Subscribe to messages
        MessagingCenter.Subscribe<object, string>(this, "CallStateChanged", (sender, state) =>
        {
            InvokeAsync(() => UpdateState(state));
        });
        
        // Also subscribe to incoming call message if still used
         MessagingCenter.Subscribe<object, string>(this, "IncomingCall", (sender, number) =>
        {
            _incomingNumber = number;
            _callStatus = "Incoming";
            StateHasChanged();
        });
    }

    private void UpdateState(string state)
    {
        Console.WriteLine($"Call State: {state}");
        
        if (state == "Active")
        {
            _callStatus = "Active";
            StartTimer();
        }
        else if (state == "Disconnected" || state == "Disconnecting")
        {
            _callStatus = "Ended";
            StopTimer();
            // Auto close after 2 seconds?
             Task.Delay(2000).ContinueWith(_ => InvokeAsync(GoBack));
        }
        else if (state == "Dialing")
        {
            _callStatus = "Dialing";
        }
        else if (state == "Ringing")
        {
            _callStatus = "Ringing";
            // _callStatus = "Incoming"; // or Ringing
        }
        
        StateHasChanged();
    }

    private void StartTimer()
    {
        if (_timer == null)
        {
            _timer = new System.Timers.Timer(1000);
            _timer.Elapsed += (s, e) =>
            {
                _duration = _duration.Add(TimeSpan.FromSeconds(1));
                InvokeAsync(StateHasChanged);
            };
            _timer.Start();
        }
    }

    private void StopTimer()
    {
        _timer?.Stop();
        _timer = null;
    }

    private void AnswerCall()
    {
        CallHandler.AnswerCall();
        _callStatus = "Active"; // Optimistic update
    }

    private void RejectCall()
    {
        CallHandler.RejectCall();
        _callStatus = "Ended";
    }

    private void EndCall()
    {
        CallHandler.EndCall();
    }

    private void ToggleMute()
    {
        CallHandler.ToggleMute();
        _isMuted = !_isMuted;
    }

    private void ToggleSpeaker()
    {
        CallHandler.ToggleSpeaker();
        _isSpeaker = !_isSpeaker;
    }
    
    private void GoBack()
    {
        // Navigate back or close wrapper
        // MainThread.BeginInvokeOnMainThread(async () => {
        //     await App.Current.MainPage.Navigation.PopModalAsync();
        // });
        // Assuming CallPage is a Modal or we just navigate away?
        // Actually CallPage is usually pushed.
    }
    
    public void Dispose()
    {
        MessagingCenter.Unsubscribe<object, string>(this, "CallStateChanged");
        MessagingCenter.Unsubscribe<object, string>(this, "IncomingCall");
        StopTimer();
    }
}