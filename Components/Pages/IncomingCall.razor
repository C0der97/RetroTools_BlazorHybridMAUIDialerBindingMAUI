@page "/calls"
@inject IJSRuntime JSRuntime
@inject ICallHandler CallHandler
@using Microsoft.Maui.Controls
@using PayRemind.Contracts
@using System.Timers

<div class="call-screen-bg" style="min-height: 100vh; width: 100%;">
    <div style="min-height: 100vh; width: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: 20px 16px; position: relative;">
        
        <!-- Top spacer -->
        <div style="height: 10px;"></div>
        
        <!-- Caller Info Section -->
        <div class="fade-in" style="display: flex; flex-direction: column; align-items: center; gap: 16px;">
            
            <!-- Avatar with Pulse Rings -->
            <div class="avatar-container scale-in">
                <!-- Pulse rings based on call state -->
                @if (_callStatus == "Dialing")
                {
                    <div class="pulse-ring dialing"></div>
                    <div class="pulse-ring dialing"></div>
                    <div class="pulse-ring dialing"></div>
                }
                else if (_callStatus == "Active")
                {
                    <div class="pulse-ring active"></div>
                    <div class="pulse-ring active"></div>
                }
                else if (_callStatus == "Incoming" || _callStatus == "Ringing")
                {
                    <div class="pulse-ring incoming"></div>
                    <div class="pulse-ring incoming"></div>
                    <div class="pulse-ring incoming"></div>
                }
                
                <!-- Avatar -->
                <MudAvatar Style="width: 130px; height: 130px; z-index: 2;" 
                           Class="@GetAvatarClass()">
                    @if (!string.IsNullOrEmpty(_contactPhoto))
                    {
                        <MudImage Src="@_contactPhoto" Alt="Contact" ObjectFit="ObjectFit.Cover" 
                                  Width="130" Height="130" Class="rounded-circle" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" Style="font-size: 60px; color: white;" />
                    }
                </MudAvatar>
            </div>
            
            <!-- Caller Name -->
            <h2 class="caller-name" style="margin: 0; text-align: center;">
                @(string.IsNullOrEmpty(_contactName) ? _incomingNumber : _contactName)
            </h2>
            
            <!-- Caller Number (if different from name) -->
            @if (!string.IsNullOrEmpty(_contactName))
            {
                <p class="caller-number" style="margin: 0;">@_incomingNumber</p>
            }
            
            <!-- Call Status -->
            <p class="call-status">
                @GetStatusText()
                @if (_callStatus == "Dialing")
                {
                    <span class="loading-dots"></span>
                }
            </p>
            
            <!-- Duration Timer -->
            @if (_callStatus == "Active")
            {
                <p class="call-duration">@_duration.ToString(@"mm\:ss")</p>
            }
        </div>
        
        <!-- Call Controls -->
        <div class="slide-up" style="padding-bottom: 20px;">
            @if (_callStatus == "Incoming" || _callStatus == "Ringing")
            {
                <!-- Incoming Call Buttons -->
                <div style="display: flex; justify-content: space-around; align-items: center;">
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 10px;">
                        <button class="reject-call-btn" @onclick="RejectCall">
                            <MudIcon Icon="@Icons.Material.Filled.CallEnd" Style="color: white; font-size: 32px;" />
                        </button>
                        <span style="color: rgba(255,255,255,0.7); font-size: 14px;">Rechazar</span>
                    </div>
                    
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 10px;">
                        <button class="answer-call-btn" @onclick="AnswerCall">
                            <MudIcon Icon="@Icons.Material.Filled.Call" Style="color: white; font-size: 32px;" />
                        </button>
                        <span style="color: rgba(255,255,255,0.7); font-size: 14px;">Contestar</span>
                    </div>
                </div>
            }
            else if (_callStatus == "Active" || _callStatus == "Dialing")
            {
                <!-- Active/Dialing Call Controls -->
                <div class="call-controls-container">
                    <div style="display: flex; justify-content: space-around; align-items: center; margin-bottom: 25px;">
                        <!-- Mute Button -->
                        <div style="display: flex; flex-direction: column; align-items: center; gap: 8px;">
                            <button class="call-action-btn @(_isMuted ? "muted" : "")" 
                                    style="background: rgba(255,255,255,0.15);" 
                                    @onclick="ToggleMute">
                                <MudIcon Icon="@(_isMuted ? Icons.Material.Filled.MicOff : Icons.Material.Filled.Mic)" 
                                         Style="color: white; font-size: 28px;" />
                            </button>
                            <span style="color: rgba(255,255,255,0.7); font-size: 12px;">
                                @(_isMuted ? "Silenciado" : "Silenciar")
                            </span>
                        </div>
                        
                        <!-- Keypad Button -->
                        <div style="display: flex; flex-direction: column; align-items: center; gap: 8px;">
                            <button class="call-action-btn" 
                                    style="background: rgba(255,255,255,0.15);" 
                                    @onclick="ToggleKeypad">
                                <MudIcon Icon="@Icons.Material.Filled.Dialpad" 
                                         Style="color: white; font-size: 28px;" />
                            </button>
                            <span style="color: rgba(255,255,255,0.7); font-size: 12px;">Teclado</span>
                        </div>
                        
                        <!-- Speaker Button -->
                        <div style="display: flex; flex-direction: column; align-items: center; gap: 8px;">
                            <button class="call-action-btn @(_isSpeaker ? "speaker-on" : "")" 
                                    style="background: rgba(255,255,255,0.15);" 
                                    @onclick="ToggleSpeaker">
                                <MudIcon Icon="@(_isSpeaker ? Icons.Material.Filled.VolumeUp : Icons.Material.Filled.VolumeOff)" 
                                         Style="color: white; font-size: 28px;" />
                            </button>
                            <span style="color: rgba(255,255,255,0.7); font-size: 12px;">
                                @(_isSpeaker ? "Altavoz" : "Auricular")
                            </span>
                        </div>
                    </div>
                    
                    <!-- End Call Button -->
                    <div style="display: flex; justify-content: center;">
                        <button class="end-call-btn" @onclick="EndCall">
                            <MudIcon Icon="@Icons.Material.Filled.CallEnd" Style="color: white; font-size: 36px;" />
                        </button>
                    </div>
                </div>
            }
            else if (_callStatus == "Ended")
            {
                <!-- Call Ended -->
                <div class="call-ended" style="display: flex; flex-direction: column; align-items: center; gap: 20px;">
                    <div style="background: rgba(255,255,255,0.1); border-radius: 20px; padding: 20px 40px;">
                        <p style="color: white; font-size: 1.2rem; margin: 0; text-align: center;">Llamada Finalizada</p>
                        <p style="color: rgba(255,255,255,0.6); font-size: 0.9rem; margin: 8px 0 0 0; text-align: center;">
                            Duración: @_duration.ToString(@"mm\:ss")
                        </p>
                    </div>
                </div>
            }
        </div>
        
    </div>
</div>

<!-- In-call Keypad Modal -->
@if (_showKeypad)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 100; display: flex; align-items: center; justify-content: center;">
        <div style="background: #1a1a2e; border-radius: 20px; padding: 20px; width: 280px;">
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
                @foreach (var key in _dialpadKeys)
                {
                    <button style="background: rgba(255,255,255,0.1); border: none; border-radius: 50%; width: 70px; height: 70px; color: white; font-size: 24px; cursor: pointer;"
                            @onclick="() => SendDTMF(key)">
                        @key
                    </button>
                }
            </div>
            <div style="display: flex; justify-content: center; margin-top: 20px;">
                <button style="background: rgba(244,67,54,0.8); border: none; border-radius: 50%; width: 60px; height: 60px; color: white; cursor: pointer;"
                        @onclick="() => _showKeypad = false">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size: 24px;" />
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string _incomingNumber = "Desconocido";
    private string _contactName = "";
    private string _contactPhoto = "";
    private string _callStatus = "Dialing"; // Incoming, Dialing, Ringing, Active, Ended
    private bool _isMuted = false;
    private bool _isSpeaker = false;
    private bool _showKeypad = false;
    private TimeSpan _duration;
    private System.Timers.Timer _timer;
    
    private readonly string[] _dialpadKeys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "*", "0", "#" };

    protected override void OnInitialized()
    {
        // Get phone number from static info
        if (!string.IsNullOrEmpty(InfoStatic.PhoneNumber))
        {
            _incomingNumber = InfoStatic.PhoneNumber;
        }
        
        // Get contact info from static info
        if (!string.IsNullOrEmpty(InfoStatic.ContactName))
        {
            _contactName = InfoStatic.ContactName;
        }
        if (!string.IsNullOrEmpty(InfoStatic.ContactPhoto))
        {
            _contactPhoto = InfoStatic.ContactPhoto;
        }

        // Determine initial state based on call direction
        if (!string.IsNullOrEmpty(InfoStatic.CallDirection) && InfoStatic.CallDirection == "Incoming")
        {
            _callStatus = "Incoming";
        }
        else
        {
            _callStatus = "Dialing";
        }

        // Subscribe to call state changes
        MessagingCenter.Subscribe<object, string>(this, "CallStateChanged", (sender, state) =>
        {
            InvokeAsync(() => UpdateState(state));
        });
        
        // Subscribe to incoming call message
        MessagingCenter.Subscribe<object, string>(this, "IncomingCall", (sender, number) =>
        {
            _incomingNumber = number;
            _callStatus = "Incoming";
            StateHasChanged();
        });
        
        // Subscribe to contact info updates
        MessagingCenter.Subscribe<object, (string Name, string Photo)>(this, "ContactInfo", (sender, info) =>
        {
            _contactName = info.Name;
            _contactPhoto = info.Photo;
            StateHasChanged();
        });
    }
    
    private string GetAvatarClass()
    {
        return _callStatus switch
        {
            "Incoming" or "Ringing" => "avatar-glow incoming",
            "Active" => "avatar-glow active",
            _ => "avatar-glow"
        };
    }
    
    private string GetStatusText()
    {
        return _callStatus switch
        {
            "Incoming" => "Llamada entrante",
            "Ringing" => "Sonando",
            "Dialing" => "Llamando",
            "Active" => "En llamada",
            "Ended" => "Finalizada",
            _ => _callStatus
        };
    }

    private void UpdateState(string state)
    {
        Console.WriteLine($"Call State: {state}");
        
        if (state == "Active")
        {
            _callStatus = "Active";
            StartTimer();
        }
        else if (state == "Disconnected" || state == "Disconnecting")
        {
            _callStatus = "Ended";
            StopTimer();
            // Auto close after 2 seconds
            Task.Delay(2000).ContinueWith(_ => InvokeAsync(GoBack));
        }
        else if (state == "Dialing")
        {
            _callStatus = "Dialing";
        }
        else if (state == "Ringing")
        {
            _callStatus = "Ringing";
        }
        
        StateHasChanged();
    }

    private void StartTimer()
    {
        if (_timer == null)
        {
            _timer = new System.Timers.Timer(1000);
            _timer.Elapsed += (s, e) =>
            {
                _duration = _duration.Add(TimeSpan.FromSeconds(1));
                InvokeAsync(StateHasChanged);
            };
            _timer.Start();
        }
    }

    private void StopTimer()
    {
        _timer?.Stop();
        _timer = null;
    }

    private void AnswerCall()
    {
        CallHandler.AnswerCall();
        _callStatus = "Active";
        StartTimer();
    }

    private void RejectCall()
    {
        CallHandler.RejectCall();
        _callStatus = "Ended";
    }

    private void EndCall()
    {
        CallHandler.EndCall();
    }

    private void ToggleMute()
    {
        CallHandler.ToggleMute();
        _isMuted = !_isMuted;
    }

    private void ToggleSpeaker()
    {
        CallHandler.ToggleSpeaker();
        _isSpeaker = !_isSpeaker;
    }
    
    private void ToggleKeypad()
    {
        _showKeypad = !_showKeypad;
    }
    
    private void SendDTMF(string key)
    {
        // TODO: Implement DTMF sending through CallHandler
        Console.WriteLine($"DTMF: {key}");
    }
    
    private void GoBack()
    {
        // Navigate back - the call ended
        MainThread.BeginInvokeOnMainThread(async () =>
        {
            try
            {
                // Clear call direction
                InfoStatic.CallDirection = "";
                // Try to navigate away or close
            }
            catch { }
        });
    }
    
    public void Dispose()
    {
        MessagingCenter.Unsubscribe<object, string>(this, "CallStateChanged");
        MessagingCenter.Unsubscribe<object, string>(this, "IncomingCall");
        MessagingCenter.Unsubscribe<object, (string, string)>(this, "ContactInfo");
        StopTimer();
    }
}