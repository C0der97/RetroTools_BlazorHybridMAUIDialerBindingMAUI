@page "/contacts"
@using PayRemind.Contracts
@inject IContactsService ContactsService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICallHandler CallHandler
@inject PayRemind.Data.BlockedNumberRepository BlockedRepository


<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="pa-0 relative-container" Style="height: 100%; position: relative;">
    <MudStack Row="true" Class="ma-4 align-center">
        <MudText Typo="Typo.h5" Class="glass-text">Contactos</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="searchString" Placeholder="Buscar" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0 glass-text"></MudTextField>
    </MudStack>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="ma-4"/>
    }
    else if (filteredContacts == null || filteredContacts.Count == 0)
    {
        <MudStack AlignItems="AlignItems.Center" Class="ma-4">
             <MudText>No se encontraron contactos.</MudText>
             <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadContacts">Reintentar</MudButton>
        </MudStack>
    }
    else
    {
        <MudList T="string" Class="glass-panel mt-4" Style="background: transparent; height: calc(100vh - 180px); overflow-y: auto;">
            @foreach (var contact in filteredContacts)
            {
                <MudListItem Class="glass-list-item">
                    <div class="d-flex align-center">
                        <MudAvatar Image="@contact.PhotoUri" Color="Color.Primary" Class="mr-3">
                            @if (string.IsNullOrEmpty(contact.PhotoUri))
                            {
                                @(string.IsNullOrEmpty(contact.Name) ? "?" : contact.Name.Substring(0, 1).ToUpper())
                            }
                        </MudAvatar>
                        <div @onclick="@(() => CallNumber(contact.PhoneNumber))" style="flex-grow: 1;">
                            <MudText Typo="Typo.body1" Class="glass-text">@contact.Name</MudText>
                            <MudText Typo="Typo.caption" Class="glass-text-secondary">@contact.PhoneNumber</MudText>
                        </div>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default">
                            <MudMenuItem OnClick="@(() => EditContact(contact.Id))">Editar</MudMenuItem>
                            <MudMenuItem OnClick="@(() => BlockContact(contact))">Bloquear</MudMenuItem>
                            <MudMenuItem OnClick="@(() => DeleteContact(contact))">Eliminar</MudMenuItem>
                        </MudMenu>
                         <MudIconButton Icon="@Icons.Material.Filled.Call" Color="Color.Success" Size="Size.Small" OnClick="@(() => CallNumber(contact.PhoneNumber))" />
                    </div>
                </MudListItem>
                <MudDivider Class="glass-divider"/>
            }
        </MudList>
    }

    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="fab-bottom-right" OnClick="AddContact" Style="position: absolute; bottom: 16px; right: 16px;" />
</MudContainer>

@code {
    private List<ContactEntry> contacts = new();
    private List<ContactEntry>? filteredContacts = new();
    private string _searchString = "";
    private bool isLoading = true;

    private string searchString
    {
        get => _searchString;
        set
        {
            _searchString = value;
            FilterContacts();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadContacts();
    }

    private async Task LoadContacts()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        
        try
        {
            // Timeout after 5 seconds to prevent infinite loader
            var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            
            var status = await Permissions.CheckStatusAsync<Permissions.ContactsRead>();
            
            if (status != PermissionStatus.Granted)
            {
                status = await Permissions.RequestAsync<Permissions.ContactsRead>();
            }

            if (status == PermissionStatus.Granted)
            {
                 // ContactsService.GetContactsAsync is already running on a background thread via Task.Run locally
                 // We await it directly.
                 contacts = await ContactsService.GetContactsAsync();
                 FilterContacts();
            }
            else
            {
                Snackbar.Add("Permiso de contactos requerido", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading contacts: {ex.Message}");
            Snackbar.Add($"Error cargando contactos: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void FilterContacts()
    {
        if (string.IsNullOrWhiteSpace(searchString))
        {
            filteredContacts = contacts;
        }
        else
        {
            filteredContacts = contacts.Where(c => 
                (c.Name?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) || 
                (c.PhoneNumber?.Contains(searchString) ?? false)
            ).ToList();
        }
    }



    private async void CallNumber(string number)
    {
        if (string.IsNullOrEmpty(number)) return;
        try
        {
            // Set call info for the call screen
            InfoStatic.PhoneNumber = number;
            InfoStatic.CallDirection = "Outgoing";
            
            // Get contact name if available
            var contact = contacts?.FirstOrDefault(c => c.PhoneNumber == number);
            if (contact != null)
            {
                InfoStatic.ContactName = contact.Name ?? "";
                InfoStatic.ContactPhoto = contact.PhotoUri ?? "";
            }
            else
            {
                InfoStatic.ContactName = "";
                InfoStatic.ContactPhoto = "";
            }

            var status = await Permissions.CheckStatusAsync<Permissions.Phone>();
             if (status != PermissionStatus.Granted)
            {
                status = await Permissions.RequestAsync<Permissions.Phone>();
            }

            if (status == PermissionStatus.Granted)
            {
                 CallHandler.PlaceCall(number);
                 await Task.Delay(100);
                 NavigationManager.NavigateTo("/calls");
            }
            else
            {
                Snackbar.Add("Permiso de teléfono requerido para llamar.", Severity.Warning);
                 // Fallback to system dialer if permission denied or mostly for safety
                PhoneDialer.Open(number);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error dialing: {ex.Message}");
            PhoneDialer.Open(number);
        }
    }

    private void AddContact()
    {
        NavigationManager.NavigateTo("/contact/edit");
    }

    private void EditContact(string id)
    {
        NavigationManager.NavigateTo($"/contact/edit/{id}");
    }

    private async Task DeleteContact(ContactEntry contact)
    {
        var status = await Permissions.CheckStatusAsync<Permissions.ContactsWrite>();
        if (status != PermissionStatus.Granted)
        {
            status = await Permissions.RequestAsync<Permissions.ContactsWrite>();
        }

        if (status != PermissionStatus.Granted)
        {
            Snackbar.Add("Permiso de escritura requerido para eliminar contactos.", Severity.Warning);
            return;
        }

        bool? resultConf = await DialogService.ShowMessageBox(
            "Eliminar contacto", 
            $"¿Estás seguro de eliminar a {contact.Name}?", 
            yesText: "Eliminar", cancelText: "Cancelar");

        if (resultConf == true)
        {
            (bool success, string error) result = await ContactsService.DeleteContactAsync(contact.Id);
            if (result.success)
            {
                Snackbar.Add("Contacto eliminado", Severity.Success);
                await LoadContacts();
            }
            else
            {
                Snackbar.Add($"Error al eliminar contacto: {result.error}", Severity.Error);
            }
        }
    }
    private async Task BlockContact(ContactEntry contact)
    {
        if (string.IsNullOrEmpty(contact.PhoneNumber))
        {
            Snackbar.Add("Este contacto no tiene número para bloquear", Severity.Warning);
            return;
        }

        bool? result = await DialogService.ShowMessageBox(
            "Bloquear Contacto",
            $"¿Quieres bloquear a {contact.Name} ({contact.PhoneNumber})? Las llamadas serán rechazadas automáticamente.",
            yesText: "Bloquear", cancelText: "Cancelar");

        if (result == true)
        {
            if (await BlockedRepository.IsBlockedAsync(contact.PhoneNumber))
            {
                Snackbar.Add("El número ya está bloqueado", Severity.Info);
                return;
            }

            await BlockedRepository.SaveBlockedNumberAsync(new PayRemind.Data.BlockedNumber 
            { 
                PhoneNumber = contact.PhoneNumber 
            });
            Snackbar.Add("Contacto bloqueado", Severity.Success);
        }
    }
}
