@page "/messages"
@using PayRemind.Contracts
@inject ISmsService SmsService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="pa-0 relative-container" Style="height: 100%; position: relative;">
     <MudStack Row="true" Class="ma-4 align-center">
        <MudText Typo="Typo.h5" Class="glass-text">Mensajes</MudText>
        <MudSpacer />
    </MudStack>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="ma-4"/>
    }
    else if (conversations == null || conversations.Count == 0)
    {
        <MudText Class="ma-4">No hay conversaciones.</MudText>
    }
    else
    {
        <MudList T="string" Class="glass-panel mt-4" Style="background: transparent; height: calc(100vh - 180px); overflow-y: auto;">
            @foreach (var conv in conversations)
            {
                <MudListItem OnClick="@(() => OpenThread(conv.ThreadId))" Class="glass-list-item">
                    <div class="d-flex align-center">
                        <MudAvatar Color="Color.Primary" Class="mr-3">
                            @(string.IsNullOrEmpty(conv.Address) ? "?" : conv.Address.Substring(0, 1).ToUpper())
                        </MudAvatar>
                        <div style="flex-grow: 1; overflow: hidden;">
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body1" Class="glass-text" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @conv.Address
                                </MudText>
                                <MudText Typo="Typo.caption" Class="glass-text-secondary">
                                    @FormatDate(conv.Date)
                                </MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="glass-text-secondary" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @conv.Snippet
                            </MudText>
                        </div>
                    </div>
                </MudListItem>
                <MudDivider Class="glass-divider"/>
            }
        </MudList>
    }
     <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Message" Class="fab-bottom-right" OnClick="NewMessage" Style="position: absolute; bottom: 16px; right: 16px;" />
</MudContainer>

@code {
    private List<SmsConversation> conversations = new();
    private bool isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadConversations();
            StateHasChanged();
        }
    }

    private async Task LoadConversations()
    {
        isLoading = true;
        try
        {
            var status = await Permissions.CheckStatusAsync<Permissions.Sms>();
            if (status != PermissionStatus.Granted)
            {
                status = await Permissions.RequestAsync<Permissions.Sms>();
            }

            if (status == PermissionStatus.Granted)
            {
                conversations = await SmsService.GetConversationsAsync();
            }
            else
            {
                Snackbar.Add("Permiso de SMS requerido", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading conversations: {ex.Message}");
            Snackbar.Add($"Error cargando mensajes: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenThread(string threadId)
    {
        NavigationManager.NavigateTo($"/messages/{threadId}");
    }

    private async Task NewMessage()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<NewMessageDialog>("Nuevo Mensaje", options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is string phoneNumber)
        {
            // Navigate to thread with "new" as ID and address as query param
            // Note: We need to encode the address
            var uri = $"/messages/new?address={Uri.EscapeDataString(phoneNumber)}";
            NavigationManager.NavigateTo(uri);
        }
    }
    
    private string FormatDate(long date)
    {
         DateTime start = new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc);
         DateTime dt = start.AddMilliseconds(date).ToLocalTime();
         
         if (dt.Date == DateTime.Today)
         {
             return dt.ToString("t");
         }
         return dt.ToString("d");
    }
}
