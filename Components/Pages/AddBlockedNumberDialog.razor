@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="Name" Label="Nombre (Opcional)" />
        <MudTextField @bind-Value="PhoneNumber" Label="Número de Teléfono" InputType="InputType.Telephone" Required="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Error" OnClick="Submit">Bloquear</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public string PhoneNumber { get; set; }
    [Parameter] public string Name { get; set; }

    void Submit()
    {
        if (string.IsNullOrWhiteSpace(PhoneNumber))
        {
            return;
        }
        MudDialog.Close(DialogResult.Ok(new PayRemind.Data.BlockedNumber { PhoneNumber = PhoneNumber, Name = Name }));
    }

    void Cancel() => MudDialog.Cancel();
}
