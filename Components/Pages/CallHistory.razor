@page "/recents"
@using PayRemind.Contracts
@inject ICallLogService CallLogService
@inject PayRemind.Data.BlockedNumberRepository BlockedRepository
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="pa-0">
    <MudText Typo="Typo.h5" GutterBottom="true" Class="ma-4 glass-text">Recientes</MudText>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="ma-4"/>
    }
    else if (callLogs == null || callLogs.Count == 0)
    {
        <MudText Class="ma-4">No hay llamadas recientes.</MudText>
    }
    else
    {
        <MudList T="string" Class="glass-panel mt-4" Style="background: transparent;">
            @foreach (var log in callLogs)
            {
                <MudListItem OnClick="@(() => CallNumber(log.Number))" Class="glass-list-item">
                    <div class="d-flex justify-space-between align-center">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@GetIcon(log.Type)" Color="@GetColor(log.Type)" Class="mr-3" />
                            <div>
                                <MudText Typo="Typo.body1" Class="glass-text">@(string.IsNullOrEmpty(log.Name) ? log.Number : log.Name)</MudText>
                                <MudText Typo="Typo.caption" Class="glass-text-secondary">@FormatDuration(log.Duration) • @FormatDate(log.Date)</MudText>
                            </div>
                        </div>

                         <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default">
                            <MudMenuItem OnClick="@(() => CallNumber(log.Number))">Llamar</MudMenuItem>
                            <MudMenuItem OnClick="@(() => BlockNumber(log))">Bloquear</MudMenuItem>
                        </MudMenu>
                    </div>
                </MudListItem>
                <MudDivider Class="glass-divider"/>
            }
        </MudList>
    }
</MudContainer>

@code {
    private List<CallLogEntry> callLogs = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadCallLogs();
    }

    private async Task LoadCallLogs()
    {
        isLoading = true;
        try
        {
            var status = await Permissions.CheckStatusAsync<Permissions.Phone>();
            if (status != PermissionStatus.Granted)
            {
                status = await Permissions.RequestAsync<Permissions.Phone>();
            }

            // Also check CallLog permission specifically for Android if needed, 
            // but Permissions.Phone might cover READ_CALL_LOG in MAUI standard permissions? 
            // MAUI Permissions.Phone covers READ_PHONE_STATE. 
            // READ_CALL_LOG is not directly in MAUI Essentials permissions enum usually?
            // Let's assume we might need a custom permission request if this fails.
            
            // For now, let's try calling the service.
            if (status == PermissionStatus.Granted)
            {
                 callLogs = await CallLogService.GetCallLogsAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading call logs: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetIcon(string type)
    {
        return type switch
        {
            "Incoming" => Icons.Material.Filled.CallReceived,
            "Outgoing" => Icons.Material.Filled.CallMade,
            "Missed" => Icons.Material.Filled.CallMissed,
            "Rejected" => Icons.Material.Filled.CallEnd,
            _ => Icons.Material.Filled.Phone
        };
    }

    private Color GetColor(string type)
    {
         return type switch
        {
            "Incoming" => Color.Info,
            "Outgoing" => Color.Success,
            "Missed" => Color.Error,
            "Rejected" => Color.Error,
            _ => Color.Default
        };
    }

    private string FormatDuration(string duration)
    {
        if (int.TryParse(duration, out int seconds))
        {
            TimeSpan ts = TimeSpan.FromSeconds(seconds);
            return ts.ToString(@"mm\:ss");
        }
        return duration;
    }

    private string FormatDate(long date)
    {
        DateTime start = new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc);
        DateTime dt = start.AddMilliseconds(date).ToLocalTime();
        return dt.ToString("g");
    }

    private void CallNumber(string number)
    {
        if (string.IsNullOrEmpty(number)) return;
        try
        {
            PhoneDialer.Open(number);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error dialing: {ex.Message}");
        }
    }
    private async Task BlockNumber(CallLogEntry log)
    {
        if (await BlockedRepository.IsBlockedAsync(log.Number))
        {
            Snackbar.Add("El número ya está bloqueado", Severity.Info);
            return;
        }

        var parameters = new DialogParameters();
        parameters.Add("PhoneNumber", log.Number);
        parameters.Add("Name", log.Name);

        var dialog = await DialogService.ShowAsync<AddBlockedNumberDialog>("Bloquear Número", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is PayRemind.Data.BlockedNumber newBlock)
        {
             if (await BlockedRepository.IsBlockedAsync(newBlock.PhoneNumber))
             {
                 Snackbar.Add("El número ya está bloqueado", Severity.Warning);
                 return;
             }

             await BlockedRepository.SaveBlockedNumberAsync(newBlock);
             Snackbar.Add("Número bloqueado", Severity.Success);
        }
    }
}
