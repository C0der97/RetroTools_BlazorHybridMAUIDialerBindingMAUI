@page "/dialpad"
@using PayRemind.Contracts
@using PayRemind.Data
@using System.Text
@inject IContactsService ContactsService
@inject ICallHandler CallHandler
@inject NavigationManager NavigationManager



<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex flex-column" Style="height: 100%; padding: 16px; justify-content: space-between; background: transparent; overflow: hidden;">
    
    <!-- Input Display -->
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4 glass-text">@phoneNumber</MudText>

    <!-- T9 Search Results -->
    @if (filteredContacts != null && filteredContacts.Count > 0)
    {
        <MudList T="string" Style="max-height: 150px; overflow-y: auto; flex-grow: 1;" Class="mb-2 glass-panel">
            @foreach (var contact in filteredContacts.Take(3))
            {
                <MudListItem OnClick="@(() => SelectContact(contact))" Class="glass-list-item">
                    <div class="d-flex align-center">
                        <MudAvatar Image="@contact.PhotoUri" Size="Size.Small" Class="mr-2">
                             @if (string.IsNullOrEmpty(contact.PhotoUri))
                            {
                                @(string.IsNullOrEmpty(contact.Name) ? "?" : contact.Name.Substring(0, 1).ToUpper())
                            }
                        </MudAvatar>
                        <MudText Typo="Typo.body2" Class="glass-text">@contact.Name</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Class="glass-text-secondary">@contact.PhoneNumber</MudText>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
    else
    {
        <MudSpacer />
    }

    <!-- Keypad -->
    <MudGrid Spacing="1" Class="mb-2">
        @foreach (var key in keys)
        {
            <MudItem xs="4" Class="d-flex justify-center">
                <div class="glass-button" style="width: 70px; height: 70px;" @onclick="@(() => Append(key.Digit))">
                    <MudText Typo="Typo.h5" Class="glass-text">@key.Digit</MudText>
                    <MudText Typo="Typo.caption" Class="glass-text-secondary" Style="font-size: 0.7rem;">@key.Letters</MudText>
                </div>
            </MudItem>
        }
        
        <MudItem xs="4" Class="d-flex justify-center">
            <div class="glass-button" style="width: 70px; height: 70px;" @onclick="@(() => Append("*"))">
                <MudText Typo="Typo.h4" Class="glass-text">*</MudText>
            </div>
        </MudItem>
        <MudItem xs="4" Class="d-flex justify-center">
            <div class="glass-button" style="width: 70px; height: 70px;" @onclick="@(() => Append("0"))">
                <MudText Typo="Typo.h5" Class="glass-text">0</MudText>
                <MudText Typo="Typo.caption" Class="glass-text-secondary" Style="font-size: 0.7rem;">+</MudText>
            </div>
        </MudItem>
        <MudItem xs="4" Class="d-flex justify-center">
            <div class="glass-button" style="width: 70px; height: 70px;" @onclick="@(() => Append("#"))">
                <MudText Typo="Typo.h5" Class="glass-text">#</MudText>
            </div>
        </MudItem>
    </MudGrid>

    <!-- Actions -->
    <MudStack Row="true" Justify="Justify.SpaceAround" Class="mb-2 align-center">
         <div style="width: 50px;"></div>
        <MudIconButton Icon="@Icons.Material.Filled.Call" Color="Color.Success" Size="Size.Large" Class="pa-3" Style="background-color: green; color: white; border-radius: 50%;" OnClick="Call" />
        <MudIconButton Icon="@Icons.Material.Filled.Backspace" Color="Color.Default" Size="Size.Medium" OnClick="Backspace" />
    </MudStack>

</MudContainer>

@code {
    private string phoneNumber = "";
    private List<ContactEntry> allContacts = new();
    private List<ContactEntry> filteredContacts = new();
    
    private record Key(string Digit, string Letters);
    private List<Key> keys = new()
    {
        new("1", "ooo"), new("2", "ABC"), new("3", "DEF"),
        new("4", "GHI"), new("5", "JKL"), new("6", "MNO"),
        new("7", "PQRS"), new("8", "TUV"), new("9", "WXYZ")
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
             var status = await Permissions.CheckStatusAsync<Permissions.ContactsRead>();
             if (status == PermissionStatus.Granted)
             {
                 allContacts = await ContactsService.GetContactsAsync();
             }
        }
        catch {}
    }

    private void Append(string digit)
    {
        phoneNumber += digit;
        FilterContacts();
    }

    private void Backspace()
    {
        if (phoneNumber.Length > 0)
        {
            phoneNumber = phoneNumber.Substring(0, phoneNumber.Length - 1);
            FilterContacts();
        }
    }

    private void Clear()
    {
        phoneNumber = "";
        filteredContacts = null;
    }

    private void SelectContact(ContactEntry contact)
    {
        phoneNumber = contact.PhoneNumber;
        Call();
    }

    private async void Call()
    {
        if (string.IsNullOrEmpty(phoneNumber)) return;
        try
        {
            // Set call info for the call screen
            InfoStatic.PhoneNumber = phoneNumber;
            InfoStatic.CallDirection = "Outgoing";
            
            // Get contact name if available
            var contact = allContacts?.FirstOrDefault(c => Normalize(c.PhoneNumber ?? "") == Normalize(phoneNumber));
            if (contact != null)
            {
                InfoStatic.ContactName = contact.Name ?? "";
                InfoStatic.ContactPhoto = contact.PhotoUri ?? "";
            }
            else
            {
                InfoStatic.ContactName = "";
                InfoStatic.ContactPhoto = "";
            }
            
            // First initiate the call using our custom handler
            CallHandler.PlaceCall(phoneNumber);
            
            // Small delay to allow call to start
            await Task.Delay(100);
            
            // Then navigate to call screen
            NavigationManager.NavigateTo("/calls");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error dialing: {ex.Message}");
        }
    }

    private void FilterContacts()
    {
        if (string.IsNullOrEmpty(phoneNumber) || allContacts == null) 
        {
            filteredContacts = null;
            return;
        }

        filteredContacts = allContacts.Where(c => 
            c.PhoneNumber != null && 
            Normalize(c.PhoneNumber).Contains(phoneNumber)
        ).ToList();
    }

    private string Normalize(string number)
    {
        return new string(number.Where(char.IsDigit).ToArray());
    }
}
