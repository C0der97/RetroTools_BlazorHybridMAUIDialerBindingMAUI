@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider @ref="@_mudThemeProvider" Theme="@_customTheme" @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="@($"glass-app-background {(_isDarkMode ? "dark-theme" : "")}")" Style="height: 100vh; overflow: hidden;">
    <MudMainContent Style="height: calc(100vh - 86px); overflow-y: auto; overflow-x: hidden; padding-bottom: 0;">
        @Body
    </MudMainContent>
    
    <MudPaper Height="86px" Class="glass-panel d-flex justify-center align-center fixed-bottom" Elevation="0" Square="true" Style="width: 100%; border-top: 1px solid var(--glass-border); z-index: 1000;">
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="d-none" Color="Color.Transparent" Centered="true" ActivePanelIndexChanged="OnTabChanged" ActivePanelIndex="_activeTabIndex">
            <MudTabPanel Icon="@Icons.Material.Filled.AccessTime" Text="Recientes" Tag='"/recents"' />
            <MudTabPanel Icon="@Icons.Material.Filled.Dialpad" Text="Teclado" Tag='"/dialpad"' />
            <MudTabPanel Icon="@Icons.Material.Filled.Contacts" Text="Contactos" Tag='"/contacts"' />
            <MudTabPanel Icon="@Icons.Material.Filled.Message" Text="Mensajes" Tag='"/messages"' />
        </MudTabs>
    </MudPaper>
</MudLayout>

<style>
    .mud-tabs-toolbar {
        background-color: transparent !important;
    }
    
    .mud-tab {
        color: var(--glass-text-secondary) !important;
        min-width: 80px;
    }
    
    .mud-tab-active {
        color: var(--glass-text) !important;
        font-weight: bold;
    }
    
    .mud-tab-slider {
        background-color: var(--glass-highlight) !important;
        height: 3px;
    }
</style>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; }

    private bool _isDarkMode = true;
    private MudThemeProvider _mudThemeProvider;
    
    private MudTheme _customTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#2196F3", // Colors.Blue.Default
            AppbarBackground = "#00000000",
            Background = "#00000000",
            Surface = "#00000000",
            DrawerBackground = "#00000000",
            TextPrimary = "#1a1a1a",
            TextSecondary = "#555555"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#42A5F5", // Colors.Blue.Lighten1
            AppbarBackground = "#00000000", // Reverting to transparent as per original intent, but using hex
            Background = "#00000000",
            Surface = "#00000000",
            DrawerBackground = "#00000000",
            TextPrimary = "#ffffff",
            TextSecondary = "#cccccc"
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemPreference();
            await _mudThemeProvider.WatchSystemPreference(OnSystemPreferenceChanged);
            StateHasChanged();
        }
    }

    private async Task OnSystemPreferenceChanged(bool newValue)
    {
        _isDarkMode = newValue;
        StateHasChanged();
    }

    private void OnTabChanged(int index)
    {
        if (_activeTabIndex == index) return; // Prevent navigation if already on the tab (though MudTabs might not fire this)

        string target = "";
        switch (index)
        {
            case 0: target = "/recents"; break;
            case 1: target = "/dialpad"; break;
            case 2: target = "/contacts"; break;
            case 3: target = "/messages"; break;
        }
        
        // Only navigate if we are not already at the target (checking mostly the start to allow sub-pages)
        if (!string.IsNullOrEmpty(target) && !NavigationManager.Uri.Contains(target))
        {
            NavigationManager.NavigateTo(target);
        }
    }
    
    private int _activeTabIndex = 1; // Default to Dialpad (index 1)

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateActiveTab(NavigationManager.Uri);

        // Default to dialpad if at root
        if (NavigationManager.Uri.EndsWith("/") || NavigationManager.Uri.EndsWith("index.html"))
        {
            NavigationManager.NavigateTo("/dialpad");
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateActiveTab(e.Location);
    }

    private void UpdateActiveTab(string location)
    {
        int newIndex = _activeTabIndex;
        
        if (location.Contains("/recents"))
        {
            newIndex = 0;
        }
        else if (location.Contains("/dialpad") || location.Contains("/calls")) // calls might be the output of dialpad
        {
            newIndex = 1;
        }
        else if (location.Contains("/contacts"))
        {
            newIndex = 2;
        }
        else if (location.Contains("/messages"))
        {
            newIndex = 3;
        }
        
        if (_activeTabIndex != newIndex)
        {
            _activeTabIndex = newIndex;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        if (NavigationManager != null)
        {
            NavigationManager.LocationChanged -= OnLocationChanged;
        }
    }
}
